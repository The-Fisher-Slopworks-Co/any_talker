# Copy to `.env.e2e` (gitignored) before running `bun run e2e`. In CI the same
# variables come from repository secrets, so the file may be absent there.

# MTProto credentials for the account that drives the bot, from
# https://my.telegram.org -> API development tools. There is no API for this;
# they are created by hand once and then live in the repository secrets
# E2E_TG_API_ID / E2E_TG_API_HASH.
E2E_TG_API_ID=
E2E_TG_API_HASH=

# KeyDB the bot under test gets to itself. The suite flushes it between spec
# files, so never point this at the database a running bot uses —
# `docker compose up -d keydb` and a spare database index is the local setup.
E2E_KEYDB_URL=redis://localhost:6379/1
