{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    // An optional property means "may be absent", not "may be present and
    // undefined" — so a maybe-undefined value can't be forwarded into one by
    // accident. Option bags that genuinely accept both spell it `?: T |
    // undefined`; persisted records keep the bare `?:` so the key is omitted
    // rather than serialized as null.
    "exactOptionalPropertyTypes": true,

    // Some stricter flags (disabled by default)
    "noPropertyAccessFromIndexSignature": false
  }
}
