{
  "name": "any_talker",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "bun --hot ./src/main.ts",
    "start": "bun ./src/main.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@grammyjs/types": "5.0.0",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/turndown": "^5.0.6",
    "knip": "^6.32.3",
    "lefthook": "^2.1.12",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@openrouter/agent": "0.11.0",
    "@openrouter/sdk": "1.2.80",
    "bun-plugin-tailwind": "^0.1.2",
    "grammy": "^1.46.0",
    "linkedom": "^0.18.13",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  }
}
