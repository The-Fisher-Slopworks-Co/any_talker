# Required
BOT_TOKEN=
# OpenRouter API key (https://openrouter.ai/keys). The bot talks to OpenRouter
# only: per-request USD cost is the figure OpenRouter reports for the whole
# tool-calling loop, and a model it reports no cost for is flagged so the owner
# knows the ledger under-counts.
OPENROUTER_API_KEY=
BOT_OWNER_ID=

# Optional
KEYDB_URL=redis://localhost:6379
PORT=8080

# Defaults to https://openrouter.ai/api/v1 — set it only when a proxy or a
# self-hosted gateway fronts OpenRouter under its own hostname. Must include the
# version segment. The pre-OpenRouter env names still work for one release, with
# a deprecation warning on boot; see docs/migration-openrouter-agent.md.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# App attribution headers (HTTP-Referer / X-Title + X-OpenRouter-Title),
# credited by OpenRouter. Unset simply means the traffic is anonymous.
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=

# Production Compose (docker-compose.prod.yml) only
# DOMAIN is the public hostname Caddy serves on.
DOMAIN=
LETSENCRYPT_EMAIL=
# Observability retention (passed to VictoriaMetrics / VictoriaLogs).
VM_RETENTION=90d
VL_RETENTION=30d

# Logging
# LOG_FORMAT: "json" | "pretty". Defaults to "json" when NODE_ENV=production,
# "pretty" otherwise. Leave it commented out to get the default — an empty value
# is a value, and the bot refuses to boot on one.
# LOG_FORMAT=
# LOG_INCOMING_UPDATES: log metadata for every incoming Telegram update. Default: true.
LOG_INCOMING_UPDATES=true

# HTTP(S) proxy. Applies to every outbound fetch (Telegram Bot API via grammY,
# the AI endpoint, fetch_page / search_web tools, Telegram file downloads).
# Handled natively by Bun: NO_PROXY is a comma-separated list of hosts to
# bypass (exact-match against the hostname; per-entry port supported as
# "host:port"; "*" disables the proxy entirely). Lowercase variants
# (http_proxy, https_proxy, no_proxy) are also recognised.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
