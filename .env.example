# Required
BOT_TOKEN=
# Any OpenAI-compatible chat-completions endpoint. OPENAI_BASE_URL must include
# the version segment, e.g. https://api.openai.com/v1, https://openrouter.ai/api/v1,
# or a self-hosted gateway (LiteLLM, vLLM, …). Per-request USD cost is the
# provider's own reported figure where it gives one, otherwise computed from the
# pricing GET {OPENAI_BASE_URL}/models returns (0 when it returns none).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BOT_OWNER_ID=

# Optional
KEYDB_URL=redis://localhost:6379
PORT=8080

# Which non-standard extras the endpoint above accepts: "openrouter" | "generic"
# | "auto" (default). "auto" infers it from OPENAI_BASE_URL's host. Set it
# explicitly only when a proxy or gateway fronts OpenRouter under its own
# hostname — declaring "openrouter" for an endpoint that isn't one makes every
# request fail with HTTP 400. See docs/ai-provider.md.
# AI_PROVIDER_FLAVOR=auto
# App attribution headers (HTTP-Referer / X-Title), credited on gateways that
# read them. Unset simply means the traffic is anonymous.
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=

# Production Compose (docker-compose.prod.yml) only
# DOMAIN is the public hostname Caddy serves on.
DOMAIN=
LETSENCRYPT_EMAIL=
# Observability retention (passed to VictoriaMetrics / VictoriaLogs).
VM_RETENTION=90d
VL_RETENTION=30d

# Logging
# LOG_FORMAT: "json" | "pretty". Defaults to "json" when NODE_ENV=production, "pretty" otherwise.
LOG_FORMAT=
# LOG_INCOMING_UPDATES: log metadata for every incoming Telegram update. Default: true.
LOG_INCOMING_UPDATES=true

# HTTP(S) proxy. Applies to every outbound fetch (Telegram Bot API via grammY,
# the AI endpoint, fetch_page / search_web tools, Telegram file downloads).
# Handled natively by Bun: NO_PROXY is a comma-separated list of hosts to
# bypass (exact-match against the hostname; per-entry port supported as
# "host:port"; "*" disables the proxy entirely). Lowercase variants
# (http_proxy, https_proxy, no_proxy) are also recognised.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
